# ---- Required secrets (./scripts/start.sh generates random values on first run) ----
DB_USERNAME=dovideo
# Fresh installs create this MySQL account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me-now
QDRANT_API_KEY=change-me-qdrant
# Shared secret between server-go and agent-py (gRPC metadata x-internal-token).
INTERNAL_TOKEN=change-me-internal
SILICONFLOW_API_KEY=

# ---- Service addresses (values below are for running server-go / agent-py on the host) ----
SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_HOST=localhost
DB_PORT=3307
DB_NAME=media_db
DB_TIMEZONE=Asia/Shanghai
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BROKERS=localhost:9094
AGENT_GRPC_ADDR=127.0.0.1:9091
AGENT_GRPC_PORT=9091
AGENT_METRICS_PORT=9464
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=video_chunks
# Tracing: leave empty to disable. Jaeger UI: http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- Models (SiliconFlow, OpenAI-compatible) ----
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# Qwen3.x 等混合推理模型默认先"思考"，每次调用多 10–25 秒；false 关闭。换回 DeepSeek 等模型也可以保留 false
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR

# ---- Agent budgets ----
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_MAX_ESTIMATED_COST=0
AGENT_EVALUATION_ENABLED=false
# Follow-up / routing / evidence search HTTP wait.
AI_INTERACTIVE_TIMEOUT_MS=180000

# ---- Tools ----
YTDLP_PATH=yt-dlp
FFMPEG_DIR=
OCR_COMMAND=tesseract

# ---- Web client ----
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_PORT=8080
